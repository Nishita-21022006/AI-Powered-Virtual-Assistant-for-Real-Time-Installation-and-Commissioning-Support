# Copy to .env and fill in. Nothing in this file is a real secret.
#
# Only ONE credential is needed for the whole MVP: OPENROUTER_API_KEY,
# and only from phase 3 onward. The embedder, reranker and transcriber
# run locally on CPU and need no account at all.

# --- Database ---
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant

# --- Generator (the only role on an API) ---
# "openrouter" now; "self_hosted" at phase 7 when a GPU is available.
# Keep the OpenRouter balance at or above zero — a negative balance
# returns 402 even on free models.
GENERATOR_BACKEND=openrouter
GENERATOR_MODEL=qwen/qwen3-8b:free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Phase 7: the same models served locally, OpenAI-compatible, so this
# stays a config change rather than a rewrite.
SELF_HOSTED_BASE_URL=http://localhost:11434/v1

# --- Embedder (local, CPU, free, ~2 GB) ---
# Dense + sparse in one model, which is the hybrid search we need.
EMBEDDER_BACKEND=local
EMBEDDER_MODEL=BAAI/bge-m3

# --- Reranker (local, CPU, free, ~1-2 GB) ---
RERANKER_BACKEND=local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Transcriber (local, CPU, free, ~0.7 GB). Phase 6, unused before. ---
TRANSCRIBER_BACKEND=local
TRANSCRIBER_MODEL=nvidia/parakeet-tdt-0.6b-v2

# Where downloaded model weights live. Keep off the repo (.gitignore'd).
MODEL_CACHE_DIR=./models/weights

# --- Ingestion ---
INGESTION_SOURCE_DIR=./Documents
UPLOAD_MAX_FILE_MB=50

# --- Query pipeline ---
# Placeholder floor. Calibrated against the evaluation set in phase 2,
# and specific to the active reranker's score scale.
RETRIEVAL_SCORE_FLOOR=0.5
QUERY_LATENCY_BUDGET_MS=3000

# --- Cache ---
CACHE_URL=

# --- Observability ---
LOG_LEVEL=INFO
