# Copy to .env and fill in. Nothing in this file is a real secret.
#
# Only ONE credential is needed: a generator API key, and only for
# written answers. The embedder and reranker run locally on CPU and
# need no account at all — without a key the assistant still finds and
# shows the right manual sections, it just doesn't write prose.

# --- Generator (the only role on an API) ---
# Free key, no card: https://console.groq.com
# Limits are ~1,000 requests/day and 8,000 TOKENS PER MINUTE, and they
# apply per ORGANISATION, not per key — a second key on the same
# account shares the same quota. The token limit is the binding one:
# each query spends ~1,650, so about three questions a minute.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GENERATOR_BACKEND=groq
GENERATOR_MODEL=qwen/qwen3.8-27b

# OpenRouter works too — same OpenAI-compatible shape, so switching is
# these two lines. Its free tier is 50 requests/day, which is not
# enough to run the evaluation set once.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Phase 7: the same model served locally once a GPU is available.
SELF_HOSTED_BASE_URL=http://localhost:11434/v1

# --- Embedder (local, CPU, free) ---
EMBEDDER_BACKEND=local
EMBEDDER_MODEL=BAAI/bge-m3

# --- Reranker (local, CPU, free) ---
# MiniLM, measured against the two BGE rerankers in phase 2: better
# recall AND ~20x faster on CPU. bge-reranker-v2-m3 takes 42 seconds
# per query here, which is unusable — do not switch to it without
# re-measuring.
RERANKER_BACKEND=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# --- Transcriber (local, CPU, free). Phase 6, unused before then. ---
TRANSCRIBER_BACKEND=local
TRANSCRIBER_MODEL=nvidia/parakeet-tdt-0.6b-v2

# Where downloaded model weights live. Keep off the repo (.gitignore'd).
MODEL_CACHE_DIR=./models/weights

# --- Ingestion ---
INGESTION_SOURCE_DIR=./Documents
UPLOAD_MAX_FILE_MB=50

# --- Query pipeline ---
# These floors are MiniLM's score scale (raw logits, roughly -11..+8),
# calibrated against the evaluation set. They are not transferable: a
# different reranker needs them re-derived, and app/query/score_gate.py
# refuses to compare across scales rather than guess.
#
# Calibration showed the score cannot separate answerable from
# out-of-scope questions, so the floor is a loose backstop only —
# abstention is carried by the generator and by tier-3 verification.
RETRIEVAL_SCORE_FLOOR=-9.0
SHOW_SOURCES_FLOOR=-9.5
RERANK_CANDIDATES=20
TOP_K=5
QUERY_LATENCY_BUDGET_MS=3000

# --- Database (optional; the index runs in memory and caches to .cache) ---
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant

# --- Cache ---
CACHE_URL=

# --- Observability ---
LOG_LEVEL=INFO
